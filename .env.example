# ─── Neon Database ────────────────────────────────────────────────────────────
# Добавляется автоматически через интеграцию Neon в v0
DATABASE_URL=

# ─── Сообщество 1 — Диспетчерская / Сотрудники ───────────────────────────────
VK_TOKEN_COMMUNITY_1=          # API-токен сообщества (от группы, messages)
VK_CONFIRM_COMMUNITY_1=        # Строка подтверждения из настроек Callback API
VK_SECRET_COMMUNITY_1=         # Секретный ключ Callback API
VK_GROUP_ID_COMMUNITY_1=       # ID группы (число)

# ─── Сообщество 2 — Клиенты / Заказы ─────────────────────────────────────────
VK_TOKEN_COMMUNITY_2=
VK_CONFIRM_COMMUNITY_2=
VK_SECRET_COMMUNITY_2=
VK_GROUP_ID_COMMUNITY_2=

# ─── Сообщество 3 — Такси ────────────────────────────────────────────────────
VK_TOKEN_COMMUNITY_3=
VK_CONFIRM_COMMUNITY_3=
VK_SECRET_COMMUNITY_3=
VK_GROUP_ID_COMMUNITY_3=

# ─── ID чатов (peer_id) ───────────────────────────────────────────────────────
# Доставка
VK_CHAT_DISPATCH_DELIVERY=     # Диспетчерская доставки
VK_CHAT_SENIOR_DELIVERY=       # Старший состав доставки
VK_CHAT_FLOOD_DELIVERY=        # Флудилка доставки

# Такси
VK_CHAT_DISPATCH_TAXI=         # Диспетчерская такси
VK_CHAT_SENIOR_TAXI=           # Старший состав такси
VK_CHAT_FLOOD_TAXI=            # Флудилка такси

# Общие
VK_CHAT_ANNOUNCEMENTS=         # Доска объявлений
VK_CHAT_ONLINE_JOURNAL=        # Журнал активности
VK_CHAT_SPONSOR=               # Спонсорская беседа
VK_CHAT_LEADERSHIP=            # Руководство

# ─── Сайт ────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=               # openssl rand -base64 32
NEXT_PUBLIC_APP_URL=           # https://your-domain.vercel.app
